# =================================================================
# SPORTS LIVE SCORES - GO BACKEND ENGINE ENVIRONMENT
# =================================================================

PORT=18443
DATABASE_URL=postgres://postgres:postgres@localhost:25432/sportsdb?sslmode=disable
REDIS_ADDR=localhost:26379
REDIS_PASSWORD=
REDIS_DB=0

# Supabase Integration
# Get from: https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=sports-assets

# Odds API Key
# Sign up at: https://the-odds-api.com/#get-access
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_KEY=your_odds_api_key_here

# ESPN API (Public)
ESPN_API_BASE_URL=https://site.api.espn.com/apis/site/v2/sports

# Flutterwave Payments
# Sign up at: https://dashboard.flutterwave.com/signup
FLW_SECRET_KEY=FLWSECK-your-secret-key
FLW_SECRET_HASH=your_secret_hash

# Cryptomus Crypto Payments
# Sign up at: https://app.cryptomus.com/signup
CRYPTOMUS_MERCHANT_ID=your_merchant_id
CRYPTOMUS_PAYMENT_KEY=your_payment_key

# Cross-Service URLs
FRONTEND_URL=http://localhost:17080
ADMIN_URL=http://localhost:19080
ENVIRONMENT=development
SIMULATION_ENABLED=true
