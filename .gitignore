# Node.js / Next.js
**/node_modules/
**/.next/
**/out/
**/build/
**/dist/

# Go binaries and temp
**/bin/
**/*.exe
**/*.exe~
**/*.dll
**/*.so
**/*.dylib
**/tmp/

# Logs & Runtime data
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment secrets
.env
.env.*
.env.save
.env*.save
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# OS and Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Docker / Postgres / Redis local volumes
**/postgres_data/
**/redis_data/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# TypeScript incremental build cache
*.tsbuildinfo
