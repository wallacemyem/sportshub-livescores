# =================================================================
# SPORTS LIVE SCORES PLATFORM - ENVIRONMENT CONFIGURATION
# =================================================================

# -----------------------------------------------------------------
# 1. STRICT NON-STANDARD PORTS MATRIX
# -----------------------------------------------------------------
FRONTEND_PORT=17080
BACKEND_PORT=18443
ADMIN_PORT=19080
POSTGRES_PORT=25432
REDIS_PORT=26379

# -----------------------------------------------------------------
# 2. LOCAL / MANAGED POSTGRESQL DATABASE
# -----------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sportsdb
# Connection String (if running outside Docker compose, e.g. Supabase Pooler):
# DATABASE_URL=postgres://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# -----------------------------------------------------------------
# 3. SUPABASE (PostgreSQL, Realtime WAL, Storage & Auth)
# Get credentials at: https://supabase.com/dashboard
# Path: Project -> Project Settings -> API & Database
# -----------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_STORAGE_BUCKET=sports-assets

# -----------------------------------------------------------------
# 4. THE ODDS API (Live Sports Betting Odds Ingestion)
# Sign up at: https://the-odds-api.com/#get-access
# -----------------------------------------------------------------
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_API_KEY=your_odds_api_key_here

# -----------------------------------------------------------------
# 5. ESPN DATA FEED & THESPORTSDB (Team Crests, Badges & Player Headshots)
# ESPN CDN: https://site.api.espn.com/ (Free / Public, No Key Required)
# TheSportsDB: https://www.thesportsdb.com/api.php (Free V1 Key: 3)
# -----------------------------------------------------------------
ESPN_API_BASE_URL=https://site.api.espn.com/apis/site/v2/sports

# -----------------------------------------------------------------
# 6. AUTONOMOUS SIMULATION FALLBACK
# Keeps games active with realistic physics & events if feeds are offline
# -----------------------------------------------------------------
SIMULATION_ENABLED=true

# -----------------------------------------------------------------
# 7. FIAT PAYMENTS - FLUTTERWAVE v3 (Card, Mobile Money, Bank Transfer)
# Sign up at: https://dashboard.flutterwave.com/signup
# Path: Settings -> API Keys & Webhooks
# -----------------------------------------------------------------
FLW_SECRET_KEY=FLWSECK-your-flutterwave-secret-key
FLW_SECRET_HASH=your_webhook_verification_secret_hash
NEXT_PUBLIC_FLUTTERWAVE_PUBLIC_KEY=FLWPUBK-your-public-key

# -----------------------------------------------------------------
# 8. CRYPTO PAYMENTS - CRYPTOMUS (BTC, USDT, ETH, TON, SOL, etc.)
# Sign up at: https://app.cryptomus.com/signup
# Path: Business -> Create Merchant -> API Integration
# -----------------------------------------------------------------
CRYPTOMUS_MERCHANT_ID=your_merchant_uuid_here
CRYPTOMUS_PAYMENT_KEY=your_payment_api_key_here

# -----------------------------------------------------------------
# 9. REDIS CACHE & WEBSOCKET PUB/SUB BROKER
# Free Cloud Redis: https://console.upstash.com/redis
# Local Docker uses redis:6379 (Port 26379 mapped to host)
# -----------------------------------------------------------------
REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------
# 10. FRONTEND & ADMIN APPLICATION URLS
# -----------------------------------------------------------------
FRONTEND_URL=http://localhost:17080
ADMIN_URL=http://localhost:19080
NEXT_PUBLIC_API_URL=http://localhost:18443/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:18443/ws
NEXT_PUBLIC_ADMIN_URL=http://localhost:19080
